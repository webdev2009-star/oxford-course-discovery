{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "docker/production/Dockerfile"
    },
    "deploy": {
        "numReplicas": 1,
        "healthcheckPath": "/",
        "healthcheckTimeout": 600,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10,
        "sleepApplication": false
    }
}
