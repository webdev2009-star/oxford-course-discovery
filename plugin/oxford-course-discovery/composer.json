{
    "name": "oxford-international/course-discovery",
    "description": "Extensible Course Discovery system for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Oxford\\CourseDiscovery\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oxford\\CourseDiscovery\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test:unit": "phpunit --configuration phpunit-unit.xml.dist",
        "test:integration": "phpunit --configuration phpunit-integration.xml.dist",
        "lint": "phpcs --standard=phpcs.xml.dist",
        "analyse": "phpstan analyse"
    }
}
