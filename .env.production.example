# Production environment for docker-compose.prod.yml.
#
#   cp .env.production.example .env
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Values marked REQUIRED have no default and the stack refuses to start
# without them, deliberately: a production site should not boot with a
# guessable password because someone forgot a variable.

# --- Site -------------------------------------------------------------------
# REQUIRED. Include the scheme. Must match how visitors reach the site.
SITE_URL=https://courses.example.com
SITE_TITLE=Course Discovery

# Port the app container publishes. Set to 8080 when using the tls profile,
# so Caddy can own 80.
HTTP_PORT=80

# --- Administrator ----------------------------------------------------------
ADMIN_USER=admin
# REQUIRED.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# --- Database ---------------------------------------------------------------
DB_NAME=wordpress
DB_USER=wordpress
# REQUIRED.
DB_PASSWORD=
# REQUIRED.
DB_ROOT_PASSWORD=

# --- Content ----------------------------------------------------------------
# Demo courses generated on first boot. SKIP_SEED=1 for an empty catalogue.
SEED_COURSES=48
SKIP_SEED=0

# Install Advanced Custom Fields from wordpress.org. With 0, the plugin's
# built-in metaboxes are used instead.
INSTALL_ACF=1

# Keep a demo deployment out of search results.
DISCOURAGE_SEARCH_ENGINES=1

# --- HTTPS (tls profile only) ----------------------------------------------
DOMAIN=courses.example.com
ACME_EMAIL=you@example.com

# --- Salts ------------------------------------------------------------------
# Optional but recommended: without these, every deploy generates new salts and
# logs everyone out. Generate a set at:
#   https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=
