# Copy to .env and adjust as needed. Every value has a working default, so
# `docker compose up -d` works without this file.

# --- Site -------------------------------------------------------------------
SITE_PORT=8080
SITE_URL=http://localhost:8080
SITE_TITLE=Oxford Course Discovery

ADMIN_USER=admin
ADMIN_PASSWORD=password
ADMIN_EMAIL=admin@example.com

# Number of demo courses generated by bin/setup.sh
SEED_COURSES=48

# --- Database ---------------------------------------------------------------
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# --- Development ------------------------------------------------------------
WORDPRESS_DEBUG=1
